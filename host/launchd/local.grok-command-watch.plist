<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.grok-command-watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>HOME/.grok/command-watch/Grok Command Watch.app/Contents/MacOS/command-watch-companion</string>
    <string>--watch</string>
    <string>--verbose</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>StandardOutPath</key>
  <string>HOME/.grok/command-watch/companion.launchd.out</string>
  <key>StandardErrorPath</key>
  <string>HOME/.grok/command-watch/companion.launchd.err</string>
</dict>
</plist>

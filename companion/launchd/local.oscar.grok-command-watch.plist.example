<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.grok-command-watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>COMPANION_BIN</string>
    <string>--watch</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>HOME/.grok/command-watch/companion.log</string>
  <key>StandardErrorPath</key>
  <string>HOME/.grok/command-watch/companion.log</string>
</dict>
</plist>
